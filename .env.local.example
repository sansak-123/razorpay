# Copy this file to .env.local and fill in real values.
# Never commit .env.local -- it's already in .gitignore.

# --- Auth + database (required -- sign-in and per-user history) ------------
# Google sign-in and per-user storage of reconciliation runs + chat history,
# via Supabase (Postgres + Auth in one). Setup:
#   1. Create a free project at https://supabase.com
#   2. Google Cloud Console -> OAuth 2.0 Client ID (Web application).
#      Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
#   3. Supabase dashboard -> Authentication -> Providers -> Google: paste
#      the Client ID + Secret, enable the provider.
#   4. Supabase dashboard -> Project Settings -> API: copy the Project URL
#      and the `anon` `public` key below (NOT `service_role` -- not used
#      anywhere in this app; every table's Row Level Security policy keys
#      off auth.uid() instead, so the anon key is safe both client- and
#      server-side).
#   5. Supabase dashboard -> SQL Editor: run supabase/schema.sql (creates
#      the two tables + their RLS policies -- this repo can't run it for you,
#      Supabase schema changes go through their dashboard/CLI).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AI reasoning (recommended -- this is what makes it an AI agent) -------
# Powers real LLM classification for exceptions the rule engine can't
# confidently resolve on its own, and the Settlement Q&A chat. Without this
# set, those exceptions keep their rule-based guess and are tagged
# "Rule-matched" instead of "AI-reasoned" -- the app still runs fine.

# One key, any model behind it (OpenAI-compatible). Get one from
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which model OpenRouter routes to -- pick any model OpenRouter supports
# (https://openrouter.ai/models). Defaults to anthropic/claude-sonnet-4.5 if
# unset.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Live Razorpay data (optional) ------------------------------------------
# Set to "true" to pull real settlement data via Razorpay's MCP server
# instead of synthetic data. Leave unset or "false" to use synthetic data.
RAZORPAY_LIVE_MODE=false

# Test-mode API keys from your Razorpay Dashboard:
# Settings > API Keys > Generate Test Key
# IMPORTANT: use the rzp_test_ keys, never your live/production keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
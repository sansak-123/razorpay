# Copy this file to .env.local and fill in real values.
# Never commit .env.local -- it's already in .gitignore.

# --- AI reasoning (recommended -- this is what makes it an AI agent) -------
# Powers real LLM classification for exceptions the rule engine can't
# confidently resolve on its own. Set EITHER of the two options below (not
# both needed) -- Anthropic is tried first if both happen to be set.
# Without either set, those exceptions keep their rule-based guess and are
# tagged "Rule-matched" instead of "AI-reasoned" -- the app still runs fine.

# Option A: direct Anthropic key. Get one from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B: OpenRouter key instead (one key, many model providers, OpenAI-
# compatible format). Get one from https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Live Razorpay data (optional) ------------------------------------------
# Set to "true" to pull real settlement data via Razorpay's MCP server
# instead of synthetic data. Leave unset or "false" to use synthetic data.
RAZORPAY_LIVE_MODE=false

# Test-mode API keys from your Razorpay Dashboard:
# Settings > API Keys > Generate Test Key
# IMPORTANT: use the rzp_test_ keys, never your live/production keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx